#!/usr/bin/env bash
# Usage: set-secret NAME   (prompts for the value without echoing it)
set -euo pipefail
NAME="${1:?usage: set-secret NAME}"
ENV=/opt/outline/.env
read -rs -p "Value for $NAME: " VALUE; echo
touch "$ENV"; chmod 600 "$ENV"
grep -v "^${NAME}=" "$ENV" > "$ENV.tmp" || true
printf '%s=%s\n' "$NAME" "$VALUE" >> "$ENV.tmp"
mv "$ENV.tmp" "$ENV"; chmod 600 "$ENV"
echo "Saved $NAME. Restart with: cd /opt/outline && docker compose up -d"
